# Server Configuration
PORT=5001

# Database Configuration
# MongoDB connection URI (e.g., mongodb://localhost:27017/ai_interview_agent or MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017/ai_interview_agent

# Authentication Configuration
# A strong random secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Payment Integration (Razorpay)
# Razorpay Key ID and Secret obtained from your Razorpay Developer Dashboard
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# AI Integration (OpenRouter)
# OpenRouter API Key to access LLM completion endpoint (openai/gpt-4o-mini is configured in the code)
OPENROUTER_API_KEY=your_openrouter_api_key_here
